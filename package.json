{
  "name": "@hilbras/spectra",
  "version": "0.0.6",
  "description": "Autonomous AI security research engine for analyzing, investigating, and validating vulnerabilities in software projects.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "spectra": "./bin/spectra"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./domain": {
      "import": "./dist/domain/index.js",
      "types": "./dist/domain/index.d.ts"
    },
    "./tools": {
      "import": "./dist/tools/index.js",
      "types": "./dist/tools/index.d.ts"
    },
    "./investigation": {
      "import": "./dist/investigation/index.js",
      "types": "./dist/investigation/index.d.ts"
    },
    "./findings": {
      "import": "./dist/findings/index.js",
      "types": "./dist/findings/index.d.ts"
    },
    "./policies": {
      "import": "./dist/policies/index.js",
      "types": "./dist/policies/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "concurrently -n api,web \"tsx watch src/web/server.ts\" \"npm run --prefix web dev\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "oxlint src/",
    "clean": "rm -rf dist",
    "ui": "tsx src/cli/ui.tsx",
    "web:dev": "vite",
    "web:build": "npm run build && cd web && npm run build",
    "web:start": "node dist/web/server.js"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Hilbras/spectra.git"
  },
  "bugs": {
    "url": "https://github.com/Hilbras/spectra/issues"
  },
  "homepage": "https://github.com/Hilbras/spectra",
  "dependencies": {
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/auto-instrumentations-node": "^0.78.0",
    "@opentelemetry/sdk-node": "^0.220.0",
    "@types/react": "^18.3.31",
    "better-sqlite3": "^13.0.3",
    "commander": "^14.0.3",
    "cors": "^2.8.5",
    "drizzle-orm": "^0.45.2",
    "express": "^4.21.0",
    "fastify": "^5.0.0",
    "ink": "^5.2.1",
    "postgres": "^3.4.9",
    "react": "^18.3.1",
    "uuid": "^11.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.20.1",
    "@types/uuid": "^10.0.0",
    "drizzle-kit": "^0.31.0",
    "oxlint": "^1.79.0",
    "ts-morph": "^25.0.0",
    "tsx": "^4.19.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11",
    "concurrently": "^9.0.0"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    ".github",
    "bin"
  ],
  "publishConfig": {
    "access": "public"
  }
}
