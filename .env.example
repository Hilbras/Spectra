# Required. The API refuses to start if SPECTRA_JWT_SECRET is unset or under
# 32 bytes, because a shipped or default signing key lets anyone mint an admin
# token. Generate with: openssl rand -base64 48
SPECTRA_JWT_SECRET=

# Required unless you let the API generate one. Minimum 12 characters.
# If left empty, a random password is written to the admin_password volume at
# SPECTRA_ADMIN_PASSWORD_FILE. Retrieve it with:
#   docker compose exec api cat /run/spectra/initial-admin-password
SPECTRA_ADMIN_PASSWORD=

# Used by the postgres service, and interpolated into both connection strings.
POSTGRES_PASSWORD=

# Port the API is published on. Must match the server's configured port (8080).
SPECTRA_PORT=8080

# Comma-separated origin allowlist for browser access to the API. Unset means no
# cross-origin browser access. Never use `*`: the API authenticates with a bearer
# token, and a wildcard lets any site read authenticated responses.
SPECTRA_CORS_ORIGINS=

# Set true only to scan internal hosts. This also re-opens SSRF against the
# scanner, because the server fetches whatever target it is given.
SPECTRA_ALLOW_INTERNAL_TARGETS=false

# Ceilings on what a single scan may consume. A scan request may ask for less
# than these; it can never ask for more, and the reduction is reported back in
# `GET /scans/{id}` rather than applied silently. Leaving these unset leaves the
# limits effectively off — a caller is then bounded only by these defaults, which
# is 10,000 pages at depth 10 over 5 minutes.
SPECTRA_CRAWLER_MAX_PAGES=10000
SPECTRA_CRAWLER_MAX_DEPTH=10
SPECTRA_SCANNER_DEFAULT_TIMEOUT=300

# How many scans may run at once, and how many may be *submitted* per second. A
# scan request over the concurrency ceiling is refused with 429 and creates
# nothing. These bound how many scans run; the three above bound each one.
SPECTRA_SCANNER_MAX_CONCURRENT=10
SPECTRA_SCANNER_RATE_LIMIT_PER_SECOND=50

SPECTRA_LOG_LEVEL=info
